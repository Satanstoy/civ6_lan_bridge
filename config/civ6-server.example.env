# Rust control-plane process. Never commit a real token or database password.
CIV6_CONTROL_BIND=127.0.0.1:8080
CIV6_RELAY_BIND=10.240.0.1:32000
CIV6_RELAY_PORT=32000
CIV6_CONTROL_BEARER_TOKEN=replace-with-at-least-32-random-characters

# Optional for the 2-10 player MVP. Set it for persisted Production profile state.
CIV6_DATABASE_URL=postgres://civ6:replace-password@127.0.0.1:5432/civ6

# Optional in Phase 1; when set, join requests must include a WireGuard public key.
CIV6_WIREGUARD_INTERFACE=wg0

RUST_LOG=civ6_lan_server=info
