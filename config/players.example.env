# 复制为 players.env 后按实际房主修改；不要提交真实密钥。
WG_INTERFACE=wg0
WG_SERVER_IP=10.10.0.1
# Copy this file to config/players.env and replace with the real public endpoint.
WG_SERVER_PUBLIC_ENDPOINT=your-server-public-ip-or-hostname

# 开房玩家的 WireGuard peer IP；不是公网 IP，也不是服务器 WG IP。
CIV6_HOST_WG_IP=10.10.0.11

CIV6_GAMEPLAY_PORT=62056
CIV6_DISCOVERY_PORT_START=62900
CIV6_DISCOVERY_PORT_END=62999
