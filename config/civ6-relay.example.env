# The Rust binary serves the control API and the relay from one process.
# Keep the control API behind Caddy or another HTTPS reverse proxy.
CIV6_CONTROL_BIND=127.0.0.1:8080
CIV6_CONTROL_BEARER_TOKEN=replace-with-at-least-32-random-characters

# Bind the UDP relay only to the WireGuard interface address. Do not expose
# this port on the public interface.
CIV6_RELAY_BIND=10.240.0.1:32000
CIV6_WIREGUARD_INTERFACE=wg0

# Optional Production profile persistence. Omit this line for the in-memory
# 2-10 player MVP; a restart then requires clients to rejoin the room.
# CIV6_DATABASE_URL=postgres://civ6:password@127.0.0.1/civ6_lan_bridge
